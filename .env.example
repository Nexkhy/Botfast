# Port d'écoute du serveur
PORT=3000

# Configuration Fapshi API (Live ou Sandbox)
# Live: https://live.fapshi.com
# Sandbox: https://sandbox.fapshi.com
FAPSHI_API_URL=https://live.fapshi.com

# Identifiants Fapshi par défaut (optionnels, peuvent aussi être passés par requête)
# FAPSHI_API_KEY=votre_cle_api_ici
FAPSHI_API_USER=523f8249-0b49-48dc-8dfc-a1395caeb3e9

# Valeurs par défaut pour les paiements
DEFAULT_PAYMENT_NAME=Client Botfast
DEFAULT_PAYMENT_EMAIL=contact@botfast.local
MIN_AMOUNT=100

# Configuration Playwright (true pour tourner en arrière-plan, false pour voir le navigateur s'ouvrir en local)
HEADLESS=true
